  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "node-cron": "^4.2.1",
    "yahoo-finance2": "^3.0.0",
    "ml-matrix": "^6.12.1",
    "@google/genai": "^1.30.0",
    "@elevenlabs/elevenlabs-js": "^2.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5"
  }
