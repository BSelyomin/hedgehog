DATABASE_URL=
# Set true when serving the application over HTTPS; leave unset for local HTTP.
COOKIE_SECURE=
# Vercel operational endpoints and Cron authentication (random, at least 16 characters).
CRON_SECRET=
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=
SNOWFLAKE_CORTEX_MODEL=
# Optional: Cortex Search service with TITLE, URL, TEXT columns for event summaries.
SNOWFLAKE_SEARCH_DATABASE=
SNOWFLAKE_SEARCH_SCHEMA=
SNOWFLAKE_SEARCH_SERVICE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FRED_API_KEY=

# SnapTrade commercial keys (test keys for sandbox); keep all credentials server-side.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_ENCRYPTION_KEY=
SNAPTRADE_MODE=
APP_URL=
# Optional: identifies you to SEC EDGAR, which requires a contact, e.g. "Hedgehog you@example.com".
# Without it, past earnings-report dates are not loaded.
SEC_USER_AGENT=
